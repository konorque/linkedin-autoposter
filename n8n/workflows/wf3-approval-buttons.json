          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "00f6b758-6e31-42bf-aba1-b227e682bd54",
      "name": "Обновить статус",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
