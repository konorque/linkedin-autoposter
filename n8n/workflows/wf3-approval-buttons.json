      "id": "1e09ec61-bf7d-4cd4-ae50-f6b21900b1ab",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Забираем нажатия кнопок у Telegram (getUpdates), отвечаем на них\nconst cfg = $('Config').first().json;\nconst chatId = String(cfg.telegram_chat_id);\nconst api = (method, body) => this.helpers.httpRequest({\n  method: 'POST',\n  url: `https://api.telegram.org/bot${cfg.bot_token}/${method}`,\n  json: true,\n  body,\n});\n// Ответы Telegram (всплывашка, удаление кнопок, сообщение) не должны ломать обработку\nconst safe = async (method, body) => {\n  try { await api(method, body); } catch (e) { /* старое нажатие или кнопки уже убраны */ }\n};\n\nconst res = await api('getUpdates', { timeout: 0, allowed_updates: ['callback_query'] });\nconst updates = res.result || [];\nif (!updates.length) return [];\n\nconst actions = {\n  approve: ['approved', '✅ Одобрено. Посты встали в очередь.'],\n  skip: ['skipped', '❌ Пропущено.'],\n  regen: ['skipped', '🔄 Генерирую другую тему…'],\n};\n\nconst out = [];\nfor (const u of updates) {\n  const cq = u.callback_query;\n  if (!cq) continue;\n  if (String(cq.from.id) !== chatId) {\n    await safe('answerCallbackQuery', { callback_query_id: cq.id, text: 'Нет доступа' });\n    continue;\n  }\n  const [action, topic_id] = String(cq.data || '').split(':');\n  if (!actions[action] || !topic_id) continue;\n\n  await safe('answerCallbackQuery', { callback_query_id: cq.id, text: actions[action][1] });\n  await safe('editMessageReplyMarkup', {\n    chat_id: cq.message.chat.id,\n    message_id: cq.message.message_id,\n    reply_markup: { inline_keyboard: [] },\n  });\n  await safe('sendMessage', {\n    chat_id: cq.message.chat.id,\n    text: actions[action][1],\n    reply_parameters: { message_id: cq.message.message_id },\n  });\n  out.push({ json: { action, topic_id, new_status: actions[action][0] } });\n}\n\n// Подтверждаем получение только после обработки, чтобы при ошибке нажатия не потерялись\nawait api('getUpdates', { offset: updates[updates.length - 1].update_id + 1, timeout: 0 });\nreturn out;"
      },
      "id": "5fad4f6f-b689-4189-b3ef-e562729185e1",
      "name": "Обработка кнопок",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
