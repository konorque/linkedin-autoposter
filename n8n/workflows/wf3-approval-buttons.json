    },
    {
      "parameters": {
        "jsCode": "// Запускаем генерацию новой темы, если была нажата «Другая тема»\nconst regen = $('Обработка кнопок').all().some(i => i.json.action === 'regen');\nreturn regen ? [{ json: { regen: true } }] : [];"
      },
