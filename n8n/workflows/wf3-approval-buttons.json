              "id": "dfc13f13-a4a5-42f6-a6b0-9af6a425601e",
              "name": "telegram_chat_id",
              "value": "YOUR_TELEGRAM_CHAT_ID",
              "type": "string"
            },
            {
              "id": "5c9b78de-d8d7-4cda-a7ac-e76d3f9f8c92",
              "name": "bot_token",
              "value": "YOUR_TELEGRAM_BOT_TOKEN",
